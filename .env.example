# Copy this file to .env and fill it in. Never commit .env (it is in .gitignore).
# On Railway, set the same names under Variables instead of uploading a file.
# Keep comments on their own lines: text after a value becomes part of the value.

# The model (Gemini)
GOOGLE_API_KEY=

# NSE price API (Bearer token) and news API (username + password)
NSE_PRICE_TOKEN=
NSE_API_USER=
NSE_API_PASSWORD=

# ---- Optional: leave empty for the defaults ----
# 1 = offline sample data only (no network, no NSE credentials)
NSE_USE_SAMPLE=
# hours cached API data stays fresh (default 24)
NSE_CACHE_MAX_AGE_HOURS=
# price API address (default https://mlapi.databuildai.com)
NSE_PRICE_BASE_URL=
# model (default google_genai:gemini-3.5-flash)
NSE_MODEL=

# ---- Public server only (Railway): the password for the playground and API ----
PLAYGROUND_PASSWORD=
